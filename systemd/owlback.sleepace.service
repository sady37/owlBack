[Unit]
# 启停成对: systemctl start owlback.sleepace ↔ stop owlback.sleepace
Description=owlback — wisefido-sleepace
After=network.target

[Service]
Type=simple
User=wisefido
Group=wisefido
WorkingDirectory=/home/wisefido/owl/owlBack
ExecStart=/bin/bash /home/wisefido/owl/owlBack/scripts/systemd/owlback-run-service.sh wisefido-sleepace
ExecStop=/bin/bash /home/wisefido/owl/owlBack/wisefido-sleepace/stop-sleepace.sh
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=owlback-sleepace
