[Unit]
# 启停成对: systemctl start owlback.ai ↔ stop owlback.ai
Description=owlback — wisefido-ai
After=network.target

[Service]
Type=simple
User=wisefido
Group=wisefido
WorkingDirectory=/home/wisefido/owl/owlBack
ExecStart=/bin/bash /home/wisefido/owl/owlBack/scripts/systemd/owlback-run-service.sh wisefido-ai
ExecStop=/bin/bash /home/wisefido/owl/owlBack/wisefido-ai/stop-ai.sh
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=owlback-ai
