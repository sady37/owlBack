[Unit]
# 启停成对: systemctl start owlback.iot ↔ stop owlback.iot
Description=owlback — wisefido-iot
After=network.target

[Service]
Type=simple
User=wisefido
Group=wisefido
WorkingDirectory=/home/wisefido/owl/owlBack
ExecStart=/bin/bash /home/wisefido/owl/owlBack/scripts/systemd/owlback-run-service.sh wisefido-iot
ExecStop=/bin/bash /home/wisefido/owl/owlBack/wisefido-iot/stop-iot.sh
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=owlback-iot
