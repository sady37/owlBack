[Unit]
# systemctl start/stop owlback 仅编排各 owlback.*；真正进程在各子 unit（可单独 systemctl stop/start owlback.data 等）
# 勿再使用旧版 ExecStart=start-owlback.sh（单 bash 拉六个 go run），与分模块二选一
Description=OwlBack orchestrator (starts/stops modular owlback.* units)
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 编排需 systemctl；各子服务仍为 unit 内 User=wisefido
User=root
Group=root
WorkingDirectory=/home/wisefido/owl/owlBack
ExecStart=/bin/bash /home/wisefido/owl/owlBack/start-owlback-full.sh --systemd-exec --no-status
ExecStop=/bin/bash /home/wisefido/owl/owlBack/stop-owlback-full.sh --systemd-exec --no-status
TimeoutStartSec=180
TimeoutStopSec=180
StandardOutput=journal
StandardError=journal
SyslogIdentifier=owlback

[Install]
WantedBy=multi-user.target
