[Unit]
# 启停成对: systemctl start owlback.data ↔ stop owlback.data；脚本: ./start-data.sh ↔ ./stop-data.sh
Description=owlback — wisefido-data
After=network.target

[Service]
Type=simple
User=wisefido
Group=wisefido
WorkingDirectory=/home/wisefido/owl/owlBack
ExecStart=/bin/bash /home/wisefido/owl/owlBack/scripts/systemd/owlback-run-service.sh wisefido-data
ExecStop=/bin/bash /home/wisefido/owl/owlBack/wisefido-data/stop-data.sh
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=owlback-data
