// ddns-update.key
//
// DDNS TSIG 共享密钥 — kea-ddns + owl service 推送 zone update 用
//
// !!! 开发环境占位密钥；production 必须用 tsig-keygen 生成新密钥 !!!
// 生成命令：tsig-keygen -a hmac-sha256 ddns-update

key "ddns-update" {
    algorithm hmac-sha256;
    secret "DEV-PLACEHOLDER-KEY-REPLACE-IN-PROD-WITH-tsig-keygen-OUTPUT";
};
