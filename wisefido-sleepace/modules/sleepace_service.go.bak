func UninitializeDevice(code string) error {
	initialize()
	return unbindDevice(code)
}

func unbindDevice(code string) error {
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"deviceId": code,
		},
	}
	utils.Logger.Infof("Unbind device: %+v", request)
	response := SleepaceResponse{}
	r, err := sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/unbind")
	if err != nil {
		return err
	} else if r.StatusCode() != 200 {
		return errors.New(r.Status())
	}
	utils.Logger.Infof("Unbind device: %s", response.Msg)
	return nil
}

func GetDailyReports(deviceId utils.LongId, startDate, endDate int, page *utils.Pagination) ([]*models.SleepaceReportOutline, error) {
	if utils.IsDateValid(startDate) && utils.IsDateValid(endDate) {
		return models.GetReports(deviceId, startDate, endDate, page)
	} else {
		return nil, errors.New("invalid date")
	}
}

func GetDailyReportDetail(deviceId utils.LongId, date int) (*models.SleepaceReportDetail, error) {
	if !utils.IsDateValid(date) {
		return nil, errors.New("invalid date")
	}
	return models.GetReport(deviceId, date)
}

func GetDailyReportsValidDates(deviceId utils.LongId) ([]int, error) {
	if deviceId == 0 {
		return []int{}, nil
	}
	return models.GetReportsValidDates(deviceId)
}

func GetHistoryDailyReport(deviceId utils.LongId, startTime, endTime int64) error {
	deviceCode, err := utils.GetDeviceCodeById(deviceId.String())
	if err != nil {
		return err
	}
	return DownloadReport(deviceId, deviceCode, startTime, endTime)
}

func GetAlarmRecords(deviceId utils.LongId, startTime, endTime int64) (json.RawMessage, error) {
	initialize()
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"userId":    deviceId.String(),
			"startTime": startTime,
			"endTime":   endTime,
		},
	}
	utils.Logger.Debugf("Get alarm records request: %+v", request)
	response := SleepaceResponse{}
	req := sleepaceClient.R().SetBody(request)
	utils.Logger.Debugf("Get alarm records request: %+v", req.Body)
	req.SetResult(&response).Post("/sleepace/getalarmrecordlist")
	if response.Status != 0 {
		utils.Logger.Errorf("Get alarm records error: %s", response.Msg)
		return nil, errors.New(response.Msg)
	}
	return response.Data, nil
}

