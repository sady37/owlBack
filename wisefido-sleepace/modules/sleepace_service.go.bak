func GetDeviceLeavingMode(deviceId utils.LongId, deviceCode string) (json.RawMessage, error) {
	utils.Logger.Debugf("Get device leaving mode0: %d/%s", deviceId, deviceCode)
	initialize()
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"userId":    deviceId.String(),
			"deviceId":  deviceCode,
			"leftRight": 0,
		},
	}
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/device/getAlgMode")
	if response.Status != 0 {
		return nil, errors.New(response.Msg)
	}
	data := struct {
		AloMode int `json:"aloMode"`
	}{}
	utils.Logger.Debugf("Get device leaving mode1: %s", string(response.Data))
	err := json.Unmarshal(response.Data, &data)
	if err != nil {
		return nil, err
	}
	utils.Logger.Debugf("Get device leaving mode2: %d", data.AloMode)
	responseData := struct {
		Mode int `json:"mode"`
	}{
		Mode: data.AloMode,
	}
	result, _ := json.Marshal(responseData)
	utils.Logger.Debugf("Get device leaving mode3: %s", result)
	return result, nil
}

func DownloadReport(deviceId utils.LongId, deviceCode string, startTime, endTime int64) error {
	if deviceId == 0 {
		return errors.New("invalid device id")
	}
	initialize()
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"userId":    deviceId.String(),
			"startTime": startTime,
			"endTime":   endTime,
		},
	}
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/get24HourDailyWithMaxReport")
	if response.Status != 0 {
		return errors.New(response.Msg)
	}
	data := []json.RawMessage{}
	err := json.Unmarshal(response.Data, &data)
	if err != nil {
		return err
	}
	// timezone, _ := GetDeviceTimezone(deviceCode)
	for i := len(data) - 1; i >= 0; i-- {
		v := data[i]
		report := struct {
			Summary struct {
				ReocrdCount int   `json:"recordCount"`
				StartTime   int64 `json:"startTime"`
				StopMode    int   `json:"stopMode"`
				TimeStep    int   `json:"timeStep"`
				Timezone    int   `json:"timezone"`
			} `json:"summary"`
			Analysis struct {
				SleepStateStr json.RawMessage `json:"sleepStateStr"`
			} `json:"analysis"`
		}{}
		err := json.Unmarshal(v, &report)
		if err != nil {
			return err
		}
		// if report.Summary.Timezone != timezone {
		// 	continue
		// }
		r := models.SleepaceReport{
			DeviceId:    deviceId,
			DeviceCode:  deviceCode,
			RecordCount: report.Summary.ReocrdCount,
			Date:        timeToDate(report.Summary.StartTime),
			StartTime:   report.Summary.StartTime,
			EndTime:     report.Summary.StartTime + int64(report.Summary.TimeStep)*int64(report.Summary.ReocrdCount),
			StopMode:    report.Summary.StopMode,
			TimeStep:    report.Summary.TimeStep,
			Timezone:    report.Summary.Timezone,
			SleepState:  string(report.Analysis.SleepStateStr),
			Report:      "[" + string(v) + "]",
		}
		err = models.SaveReport(&r)
		if err != nil {
			return err
		}
	}
	return nil
}

func timeToDate(t int64) int {
	tm := time.Unix(t, 0).UTC()
	return tm.Year()*10000 + int(tm.Month())*100 + tm.Day()

}
