}

func GetDeviceMonitorSettings(deviceId utils.LongId) (*models.SleepaceMonitorSettings, error) {
	utils.Logger.Debugf("Get device monitor settings: %s", deviceId.String())
	deviceCode, err := utils.GetDeviceCodeById(deviceId.String())
	if err != nil {
		return nil, err
	}
	initialize()
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"userId": deviceId.String(),
		},
	}
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/getalarmnotifyconfig")
	if response.Status != 0 {
		return nil, errors.New(response.Msg)
	}
	utils.Logger.Debugf("Get device alarm settings response: %s", response.Data)
	settings := models.SleepaceMonitorSettings{}
	err = json.Unmarshal(response.Data, &settings)
	if err != nil {
		return nil, err
	}
	settings.Timezone, err = GetDeviceTimezone(deviceCode)
	if err != nil {
		return nil, err
	}
	return &settings, nil
}

func GetDeviceTimezone(deviceCode string) (int, error) {
	val, err := utils.GetRedisClient().HGet(context.Background(), utils.SLEEPACE_DEVICES_TIMEZONE, deviceCode).Result()
	if err == redis.Nil {
		settings, err := models.GetDeviceMonitorSettings(deviceCode)
		if err != nil {
			return 0, err
		} else if settings == nil {
			return config.Cfg.Sleepace.Timezone, nil
		}
		utils.GetRedisClient().HSet(context.Background(), utils.SLEEPACE_DEVICES_TIMEZONE, deviceCode, settings.Timezone)
		return settings.Timezone, nil
	} else if err != nil {
		return 0, err
	} else {
		return utils.Atoi(val, 0), nil
	}
}

func SetDeviceMonitorSettings(userId, deviceId utils.LongId, settings *models.SleepaceMonitorSettings) error {
	settings.UserId = deviceId.String()
	settings.DeviceId = deviceId
	settings.DeviceCode, _ = utils.GetDeviceCodeById(deviceId.String())
	timezoneChanged := false
	originalSettings, err := models.GetDeviceMonitorSettings(settings.DeviceCode)
	if err != nil {
		return err
	} else if originalSettings == nil {
		timezoneChanged = true
	} else if originalSettings.Timezone != settings.Timezone {
		timezoneChanged = true
	}

	if timezoneChanged {
		utils.GetRedisClient().HDel(context.Background(), utils.SLEEPACE_DEVICES_TIMEZONE, settings.DeviceCode)
		go setDeviceTimezone(deviceId, settings.DeviceCode, settings.Timezone)
	}

	settings.Creater = userId
	settings.Timestamp = time.Now().Unix()
	err = models.SetDeviceMonitorSettings(settings)
	if err != nil {
		return err
	}
	// settings["userId"] = deviceId.String()
	// settings["deviceId"], _ = utils.GetDeviceCodeById(deviceId.String())
	request := struct {
		Token *SleepaceToken                  `json:"token"`
		Data  *models.SleepaceMonitorSettings `json:"data"`
	}{
		Token: token,
		Data:  settings,
	}
	response := SleepaceResponse{}
	initialize()
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/updatealarmnotifyconfig")
	if response.Status != 0 {
		return errors.New(response.Msg)
	}
	return nil
}

func setDeviceTimezone(deviceId utils.LongId, deviceCode string, timezone int) error {
	initialize()
	err := unbindDevice(deviceCode)
	if err != nil {
		utils.Logger.Errorf("unbind device error: %s", err)
		return err
	}
	device := models.DeviceData{DeviceId: deviceId, DeviceCode: deviceCode}
	err = bindDevice(&device, timezone)
	if err != nil {
		utils.Logger.Errorf("bind device error: %s", err)
		return err
	}
	return nil
}

