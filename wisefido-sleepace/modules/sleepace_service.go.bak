package modules

import (
	"context"
	"encoding/json"
	"errors"
	"sync"
	"time"

	"github.com/go-redis/redis/v8"
	"github.com/go-resty/resty/v2"
	"wisefido.com/common/utils"
	"wisefido.com/wisefido-sleepace/internal/config"
	"wisefido.com/wisefido-sleepace/models"
)

type SleepaceToken struct {
	AppId     string `json:"appId"`
	SecureKey string `json:"secureKey"`
}

type SleepaceRequest struct {
	Token *SleepaceToken `json:"token"`
	Data  map[string]any `json:"data"`
}

type SleepaceAlarmSettingsRequest struct {
	Token *SleepaceToken                  `json:"token"`
	Data  *models.SleepaceMonitorSettings `json:"data"`
}

type SleepaceResponse struct {
	Status int             `json:"status"`
	Msg    string          `json:"msg"`
	Data   json.RawMessage `json:"data"`
}

type SleepaceBedParameters struct {
	Material  int `json:"material"`
	Thickness int `json:"thickness"`
}

var (
	sleepaceClient *resty.Client
	sleepaceOnce   sync.Once
	token          *SleepaceToken
)

func initialize() {
	sleepaceOnce.Do(func() {
		sleepaceClient = resty.New().
			SetBaseURL(config.Cfg.Sleepace.HttpAddress).
			SetTimeout(5*time.Second).
			SetRetryCount(3).
			SetRetryWaitTime(time.Second).
			SetRetryMaxWaitTime(5*time.Second).
			SetHeader("Content-Type", "application/json").
			SetHeader("Accept", "application/json").SetDebug(true)
		token = &SleepaceToken{
			AppId:     config.Cfg.Sleepace.AppId,
			SecureKey: config.Cfg.Sleepace.SecretKey,
		}
		setPushType()
	})
}

func InitializeDevice(device *models.DeviceData) error {
	initialize()
	if err := bindDevice(device, config.Cfg.Sleepace.Timezone); err != nil {
		return err
	}
	if err := setHeartMode(device.DeviceCode); err != nil {
		return err
	}
	if err := setRealtimeInterval(device); err != nil {
		return err
	}
	// if err := setDeviceSettings(device); err != nil {
	// 	return err
	// }
	if err := setDeviceLeaveSensibility(device); err != nil {
		return err
	}
	if err := setDeviceReportUploadType(device); err != nil {
		return err
	}
	if config.Cfg.Sleepace.ReportUploadType == utils.SLEEPACE_REPORT_UPLOAD_FIXED_TIME {
		if err := setDeviceReportUploadTime(device); err != nil {
			return err
		}
	}
	return nil
}

func setPushType() error {
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"pushType":      "MQTT",
			"alarmDataType": "array",
		},
	}
	utils.Logger.Infof("Set push type: %+v", request)
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/system/pushType/set")
	if response.Status != 0 {
		return errors.New(response.Msg)
	}
	utils.Logger.Infof("Set push type: %s", response.Msg)
	return nil
}

func bindDevice(device *models.DeviceData, timezone int) error {
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"deviceId":  device.DeviceCode,
			"leftRight": 0,
			"userId":    device.DeviceId.String(),
			"gender":    1,
			"age":       50,
			"timezone":  timezone,
		},
	}
	utils.Logger.Infof("Bind device: %+v", request)
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/bind")
	if response.Status != 0 {
		utils.Logger.Errorf("Bind device error: %s", response.Msg)
		return errors.New(response.Msg)
	}
	utils.Logger.Infof("Bind device: %s", response.Msg)
	return nil
}

func setHeartMode(deviceId string) error {
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"deviceId": deviceId,
			"mode":     1,
		},
	}
	utils.Logger.Infof("Set heart mode: %+v", request)
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/heartModeSet")
	if response.Status != 0 {
		return errors.New(response.Msg)
	}
	utils.Logger.Infof("Set heart mode: %s", response.Msg)
	return nil
}

func setRealtimeInterval(device *models.DeviceData) error {
	request := SleepaceRequest{
		Token: token,
		Data: map[string]any{
			"deviceId":  device.DeviceCode,
			"userId":    device.DeviceId.String(),
			"leftRight": 0,
			"interval":  config.Cfg.Sleepace.RealtimeInterval,
		},
	}
	utils.Logger.Infof("Set realtime interval: %+v", request)
	response := SleepaceResponse{}
	sleepaceClient.R().SetBody(request).SetResult(&response).Post("/sleepace/device/updateconfig")
	if response.Status != 0 {
		return errors.New(response.Msg)
	}
	utils.Logger.Infof("Set realtime interval: %s", response.Msg)
	return nil
}

