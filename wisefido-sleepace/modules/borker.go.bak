type Message struct {
	Topic   string
	Payload []byte
}

var messageQueue chan *Message
var cancel context.CancelFunc
var wg sync.WaitGroup
var wokerCount = 10

var (
	deviceClient *resty.Client
	deviceOnce   sync.Once
	dataClient   *resty.Client
	dataOnce     sync.Once
)

func initializeDeviceClient() {
	deviceOnce.Do(func() {
		deviceClient = resty.New().
			SetBaseURL(config.Cfg.Services.Device).
			SetTimeout(5*time.Second).
			SetRetryCount(3).
			SetRetryWaitTime(time.Second).
			SetRetryMaxWaitTime(5*time.Second).
			SetHeader("Content-Type", "application/json").
			SetHeader("Accept", "application/json").SetDebug(true)
	})
}

func initializeDataClient() {
	dataOnce.Do(func() {
		dataClient = resty.New().
			SetBaseURL(config.Cfg.Services.Data).
			SetTimeout(5*time.Second).
			SetRetryCount(3).
			SetRetryWaitTime(time.Second).
			SetRetryMaxWaitTime(5*time.Second).
			SetHeader("Content-Type", "application/json").
			SetHeader("Accept", "application/json").SetDebug(true)
	})
}

func InitBroker() {
	messageQueue = make(chan *Message, 1000)
	var ctx context.Context
	ctx, cancel = context.WithCancel(context.Background())
	for i := 0; i < wokerCount; i++ {
		wg.Add(1)
		go worker(ctx, &wg, messageQueue)
	}
}

func MqttBroker(client mqtt.Client, msg mqtt.Message) {
	messageQueue <- &Message{
		Topic:   msg.Topic(),
		Payload: msg.Payload(),
	}
}

func StopBroker() {
	cancel()
	wg.Wait()
}

func worker(ctx context.Context, wg *sync.WaitGroup, queue <-chan *Message) {
	defer wg.Done()
	for {
		select {
		case <-ctx.Done():
			return
		case msg := <-queue:
			handleMessage(msg)
		}
	}
}

func handleMessage(msg *Message) {
	utils.Logger.Tracef("Received message: %s from topic: %s", msg.Payload, msg.Topic)
	p := make([]*models.ReceivedMessage, 0)
	err := json.Unmarshal(msg.Payload, &p)
	if err != nil {
		utils.Logger.Errorf("Error unmarshaling message: %v", err)
		return
	}
	for _, v := range p {
		updateActiveDevicesCatch(v.DeviceId)
		switch v.DataKey {
		case "connectionStatus":
			data := models.ConnectionStatusData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleConnectionEvent(&data)
		case "realtime":
			data := models.RealtimeData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleRealtimeData(&data)
		case "inBedStatus":
			data := models.InBedStatusData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			// handleInbedStatusEvent(&data)
		case "sleepStage":
			data := models.SleepStageData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleSleepStageEvent(&data)
		case "deviceSenSor", "pressureSenSor":
			data := models.SensorData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			if v.DataKey == "deviceSenSor" {
				handleDeviceSensorEvent(&data)
			} else {
				handlePressureSensorEvent(&data)
			}
		case "analysis":
			data := models.AnalysisData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleAnalysisEvent(&data)
		case "upgradeProgress":
			data := models.UpgradeProgressData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleUpgradeProgress(&data)
		case "alarmNotify":
			data := models.AlarmNotifyData{
				CommonData: models.CommonData{DeviceId: v.DeviceId,
					TimeStamp: v.TimeStamp},
			}
			err := json.Unmarshal(v.Data, &data)
			if err != nil {
				utils.Logger.Errorf("Error unmarshaling message: %v", err)
				continue
			}
			handleAlarmNotify(&data)
		}
	}
}

func handleConnectionEvent(data *models.ConnectionStatusData) error {
	utils.Logger.Infof("Received connection event: %+v", data)
	record := &models.SleepaceConnectionStatus{
		DeviceId:        data.DeviceId,
		TimeStamp:       data.TimeStamp,
		ConnectionState: data.ConnectionStatus,
	}
	_, err := database.Engine.Insert(record)
	if err != nil {
		return err
	}
	setDeviceStatus(data.DeviceId, "connection", data.ConnectionStatus, data.TimeStamp)
	if data.ConnectionStatus == 0 {
		device, err := models.GetDeviceByCode(data.DeviceId)
		if err != nil {
			utils.Logger.Errorf("get device by code error: %s", err)
			return err
		}
		if device == nil {
			return errors.New("device not found")
		}
		alarm := &models.AlarmNotifyData{
			CommonData: models.CommonData{
				DeviceId:  data.DeviceId,
				TimeStamp: data.TimeStamp,
			},
			Id:     time.Now().Unix(),
			Type:   "alarmOffline",
			Status: utils.ALARM_STATUS_PENDING,
			UserId: device.Id.String(),
		}
		processAlarmNotify(alarm)
	} else {
		alarm, err := getPendingAlarmRecord(data.DeviceId, utils.ALARM_TYPE_OFFLINE)
		if err != nil {
			utils.Logger.Errorf("get pending alarm record error: %s", err)
			return err
		}
		if alarm == nil {
			return nil
		}
		alarmUpdate := commonmodels.DeviceAlarm{
			Status:       utils.ALARM_STATUS_RESOLVED,
			HandleStatus: utils.ALARM_HANDLE_STATUS_AUTO,
			HandleTime:   data.TimeStamp,
		}
		_, err = database.Engine.Update(&alarmUpdate, &commonmodels.DeviceAlarm{Id: alarm.Id})
		if err != nil {
			utils.Logger.Errorf("update alarm record error: %s", err)
			return err
		}
	}
	return err
}

func getPendingAlarmRecord(deviceCode string, alarmType int) (*commonmodels.DeviceAlarm, error) {
	var record commonmodels.DeviceAlarm
	exists, err := database.Engine.Where("device_code = ? AND alarm_type = ? AND status = 0", deviceCode, alarmType).Desc("id").Limit(1).Get(&record)
	if !exists {
		return nil, nil
	}
	return &record, err
}

func handleRealtimeData(data *models.RealtimeData) error {
	utils.Logger.Tracef("Received realtime data: %+v", data)
	record := &models.SleepaceRealtimeRecord{
		DeviceId:      data.DeviceId,
		TimeStamp:     data.TimeStamp,
		LeftRight:     data.LeftRight,
		Breath:        data.Breath,
		Heart:         data.Heart,
		TurnOver:      data.TurnOver,
		BodyMove:      data.BodyMove,
		SitUp:         data.SitUp,
		InitStatus:    data.InitStatus,
		BedStatus:     data.BedStatus,
		SignalQuality: data.SignalQuality,
	}
	_, err := database.Engine.Insert(record)
	if err != nil {
		utils.Logger.Errorf("Error inserting realtime data: %v", err)
		return err
	}
	err = setDeviceStatuses(data.DeviceId, map[string]string{
		"breath":        strconv.Itoa(data.Breath),
		"heart":         strconv.Itoa(data.Heart),
		"turnOver":      strconv.Itoa(data.TurnOver),
		"bodyMove":      strconv.Itoa(data.BodyMove),
		"sitUp":         strconv.Itoa(data.SitUp),
		"initStatus":    strconv.Itoa(data.InitStatus),
		"bedStatus":     strconv.Itoa(data.BedStatus),
		"signalQuality": strconv.Itoa(data.SignalQuality),
		"connection":    "1",
	}, data.TimeStamp)
	return err
}

