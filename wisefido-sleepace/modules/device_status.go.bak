package modules

import (
	"context"
	"errors"
	"strconv"
	"time"

	"wisefido.com/common/utils"
)

func setDeviceStatus(deviceCode string, statusName string, status int, timestamp int64) error {
	if statusName == "connection" {
		timestamp = 0
	}
	statuses := make(map[string]string)
	statuses[statusName] = strconv.Itoa(status)
	statuses["timestamp"] = utils.Int64ToString(timestamp)
	// if statusName == "connection" && status == 0 {
	// 	statuses["heart"] = "0"
	// 	statuses["breath"] = "0"
	// }
	err := utils.GetRedisClient().HSet(context.Background(), utils.SleepaceDeviceKey(deviceCode), statuses).Err()
	if err != nil {
		utils.Logger.Errorf("Set device status failed! error: %s", err)
	}
	return err
}

func setDeviceStatuses(deviceCode string, statuses map[string]string, timestamp int64) error {
	utils.Logger.Debugf("Set devicees %s status: %+v", deviceCode, statuses)
	key := utils.SleepaceDeviceKey(deviceCode)
	exists, err := utils.GetRedisClient().Exists(context.Background(), key).Result()
	if err != nil {
		return err
	} else if exists > 0 {
		oldStatuses, err := utils.GetRedisClient().HGetAll(context.Background(), key).Result()
		if err != nil {
			return err
		}
		if oldStatuses["bedStatus"] != statuses["bedStatus"] ||
			oldStatuses["sitUp"] != statuses["sitUp"] {
			statuses["timestamp"] = utils.Int64ToString(timestamp)
		}
	} else {
		statuses["timestamp"] = utils.Int64ToString(timestamp)
	}
	err = utils.GetRedisClient().HSet(context.Background(), key, statuses).Err()
	// utils.GetRedisClient().Expire(context.Background(), key, time.Duration(config.Cfg.Sleepace.RealtimeInterval)*2*time.Second)
	if err != nil {
		utils.Logger.Errorf("Set device status failed! error: %s", err)
	}
	return err
}

func getDeviceCodeIdMap() (map[string]string, error) {
	return utils.GetRedisClient().HGetAll(context.Background(), utils.DEVICE_REVERSEMAP_KEY).Result()
}

func GetDeviceTotalStatus(deviceId string) (map[string]int, int64, error) {
	deviceCode, err := utils.GetDeviceCodeById(deviceId)
	if err != nil {
		return nil, 0, err
	}
	key := utils.SleepaceDeviceKey(deviceCode)
	exists, err := utils.GetRedisClient().Exists(context.Background(), key).Result()
	if err != nil {
		return nil, 0, err
	} else if exists == 0 {
		return nil, 0, errors.New("device not found")
	}
	r, err := utils.GetRedisClient().HGetAll(context.Background(), key).Result()
	if err != nil {
		return nil, 0, err
	}
	statuses := make(map[string]int)
	for k, v := range r {
		value := utils.Atoi(v, 0)
		statuses[k] = value
	}
	return statuses, time.Now().Unix(), nil
}

func GetDevicesTotalStatus() (map[string]map[string]int, int64, error) {
	r, err := utils.GetRedisClient().Keys(context.Background(), utils.DevicesKey()).Result()
	if err != nil {
		return nil, 0, err
	}
	m, err := getDeviceCodeIdMap()
	if err != nil {
		return nil, 0, err
	}
	utils.Logger.Debugf("Get device status0: %+v", m)
	result := make(map[string]map[string]int)
	for _, v := range r {
		utils.Logger.Debugf("Get device status1: %s", v)
		r, err := utils.GetRedisClient().HGetAll(context.Background(), v).Result()
		if err != nil {
			return nil, 0, err
		}
		utils.Logger.Debugf("Get device status2: %+v", r)
		key := v[len(utils.SLEEPACE_DEVICE_KEY_PREFIX):]
		key = m[key]
		utils.Logger.Debugf("Get device status3: %s", key)
		result[key] = make(map[string]int)
		m := result[key]
		for k, v := range r {
			value := utils.Atoi(v, 0)
			m[k] = value
		}
		utils.Logger.Debugf("Get device status4: %+v", m)
	}
	return result, time.Now().Unix(), nil
}
