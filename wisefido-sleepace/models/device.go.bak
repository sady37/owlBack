package models

import (
	"wisefido.com/common/database"
	"wisefido.com/common/utils"
)

type DeviceData struct {
	DeviceId    utils.LongId `json:"deviceId"`
	DeviceCode  string       `json:"deviceCode"`
	DeviceType  int          `json:"deviceType"`
	DeviceModel string       `json:"deviceModel"`
	Parameters  string       `json:"parameters"`
}

type Device struct {
	Id   utils.LongId `json:"id"`
	Name string       `json:"name"`
	Type int          `json:"type"`
	Code string       `json:"code"`
}

func GetDeviceById(id utils.LongId) (*Device, error) {
	result := Device{}
	exist, err := database.Engine.Table("device").ID(id).Get(&result)
	if err != nil {
		return nil, err
	}
	if !exist {
		return nil, nil
	}
	return &result, err
}

func GetDeviceByCode(code string) (*Device, error) {
	result := Device{Code: code}
	exist, err := database.Engine.Table("device").Get(&result)
	if err != nil {
		return nil, err
	}
	if !exist {
		return nil, nil
	}
	return &result, err
}
