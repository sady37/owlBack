package models

import (
	"fmt"
	"math"

	"wisefido.com/common/database"
	"wisefido.com/common/utils"
)

type SleepaceReport struct {
	Id          uint         `xorm:"pk autoincr"`
	DeviceId    utils.LongId `xorm:"index notnull"`
	DeviceCode  string       `xorm:"varchar(64) index notnull"`
	RecordCount int          `xorm:"notnull"`
	StartTime   int64        `xorm:"notnull"`
	EndTime     int64        `xorm:"notnull"`
	Date        int          `xorm:"notnull index"`
	StopMode    int          `xorm:"notnull"`
	TimeStep    int          `xorm:"notnull"`
	Timezone    int          `xorm:"notnull"`
	SleepState  string       `xorm:"text"`
	Report      string       `xorm:"longtext"`
	CreatedAt   int64        `xorm:"notnull created"`
	UpdatedAt   int64        `xorm:"notnull updated"`
}

type SleepaceReportOutline struct {
	Id          uint         `json:"id"`
	DeviceId    utils.LongId `json:"deviceId"`
	DeviceCode  string       `json:"deviceCode"`
	RecordCount int          `json:"recordCount"`
	StartTime   int64        `json:"startTime"`
	EndTime     int64        `json:"endTime"`
	Date        int          `json:"date"`
	StopMode    int          `json:"stopMode"`
	TimeStep    int          `json:"timeStep"`
	Timezone    int          `json:"timezone"`
	SleepState  string       `json:"sleepState"`
}

type SleepaceReportDetail struct {
	Id          uint         `json:"id"`
	DeviceId    utils.LongId `json:"deviceId"`
	DeviceCode  string       `json:"deviceCode"`
	RecordCount int          `json:"recordCount"`
	StartTime   int64        `json:"startTime"`
	EndTime     int64        `json:"endTime"`
	Date        int          `json:"date"`
	StopMode    int          `json:"stopMode"`
	TimeStep    int          `json:"timeStep"`
	Timezone    int          `json:"timezone"`
	Report      string       `json:"report"`
}

func SaveReport(report *SleepaceReport) error {
	exist, err := database.Engine.Exist(&SleepaceReport{DeviceId: report.DeviceId, DeviceCode: report.DeviceCode, Date: report.Date})
	if err != nil {
		return err
	}
	if exist {
		_, err := database.Engine.Update(report, &SleepaceReport{DeviceId: report.DeviceId, DeviceCode: report.DeviceCode, Date: report.Date})
		return err
	}
	_, err = database.Engine.Insert(report)
	return err
}

func GetReports(deviceId utils.LongId, startDate, endDate int, page *utils.Pagination) ([]*SleepaceReportOutline, error) {
	sql := "select * from sleepace_report where device_id = ? and date >= ? and date <= ?"
	args := []any{deviceId, startDate, endDate}
	if page != nil {
		countSql := "select count(1) as count from sleepace_report where device_id = ? and date >= ? and date <= ?"
		countResult := struct {
			Count int `xorm:"count"`
		}{}
		ok, err := database.Engine.SQL(countSql, args...).Get(&countResult)
		if ok && err == nil {
			page.Count = countResult.Count
			orderBy := ""
			if len(page.Sort) > 0 {
				orderBy = utils.SnakeString(page.Sort)
				if page.Direction == 1 {
					orderBy += " desc"
				}
			} else {
				orderBy = "date desc"
			}
			if len(orderBy) > 0 {
				sql += " order by " + orderBy
			}
			if page.Size < 1 {
				page.Size = 1
			}
			pageCount := int(math.Ceil(float64(page.Count) / float64(page.Size)))
			if page.Page > pageCount {
				page.Page = pageCount
			}
			if page.Page < 1 {
				page.Page = 1
			}
			sql += fmt.Sprintf(" limit %d, %d", (page.Page-1)*page.Size, page.Size)
		} else {
			return nil, err
		}
	}
	reports := make([]*SleepaceReportOutline, 0)
	err := database.Engine.SQL(sql, args...).Find(&reports)
	return reports, err
}

func GetReport(deviceId utils.LongId, date int) (*SleepaceReportDetail, error) {
	report := SleepaceReportDetail{DeviceId: deviceId, Date: date}
	exist, err := database.Engine.Table("sleepace_report").Get(&report)
	if err != nil {
		return nil, err
	}
	if !exist {
		return nil, nil
	}
	if report.Report[0] != '[' {
		report.Report = "[" + report.Report + "]"
	}
	return &report, nil
}

func GetReportsValidDates(deviceId utils.LongId) ([]int, error) {
	dates := make([]int, 0)
	err := database.Engine.SQL("select date from sleepace_report where device_id = ?", deviceId).Find(&dates)
	if err != nil {
		return nil, err
	}
	return dates, nil
}
