package models

// SleepaceConnectionStatus represents device connection status records
type SleepaceConnectionStatus struct {
	Id              uint   `xorm:"pk autoincr"`
	DeviceId        string `xorm:"index varchar(64)"`
	TimeStamp       int64  `xorm:"index"`
	ConnectionState int    `xorm:"notnull"`
}

// SleepaceRealtimeRecord represents realtime data records
type SleepaceRealtimeRecord struct {
	Id            uint   `xorm:"pk autoincr"`
	DeviceId      string `xorm:"index varchar(64)"`
	TimeStamp     int64  `xorm:"index"`
	LeftRight     int    `xorm:"notnull"`
	Breath        int    `xorm:"notnull"`
	Heart         int    `xorm:"notnull"`
	TurnOver      int    `xorm:"notnull"`
	BodyMove      int    `xorm:"notnull"`
	SitUp         int    `xorm:"notnull"`
	InitStatus    int    `xorm:"notnull"`
	BedStatus     int    `xorm:"notnull"`
	SignalQuality int    `xorm:"notnull"`
}

// SleepaceInBedStatus represents in-bed status records
