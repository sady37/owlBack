func GetAlarmRecords(ctx *gin.Context) {
	id := ctx.Param("id")
	idInt, err := strconv.ParseInt(id, 10, 64)
	if err != nil {
		utils.Logger.Error("request param error")
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, utils.ERRMSG_REQUEST_PARAM_ERROR, nil, http.StatusBadRequest)
		return
	}
	startTime := utils.Atoi64(ctx.Query("startTime"), 0)
	if startTime == 0 {
		start := time.Now().AddDate(0, 0, -6)
		startTime = time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, start.Location()).Unix()
	}
	utils.Logger.Debugf("startTime: %d", startTime)
	endTime := utils.Atoi64(ctx.Query("endTime"), 0)
	if endTime == 0 {
		end := time.Now()
		endTime = time.Date(end.Year(), end.Month(), end.Day(), 23, 59, 59, 0, end.Location()).Unix()
	}
	if endTime-startTime > 7*24*60*60 {
		startTime = endTime - 7*24*60*60
	}
	utils.Logger.Debugf("endTime: %d", endTime)
	deviceId := utils.LongId(idInt)
	status := utils.Atoi(ctx.Query("status"), -1)
	if status == 0 || status == 1 {
		response, err := modules.GetAlarmRecordsByStatus(deviceId, status, startTime, endTime)
		if err != nil {
			utils.ResponseErrorJson(ctx, err)
		} else {
			utils.ResponseSuccessJson(ctx, response)
		}
		return
	}
	response, err := modules.GetAlarmRecords(deviceId, startTime, endTime)
	if err != nil {
		utils.ResponseErrorJson(ctx, err)
	} else {
		utils.ResponseSuccessJson(ctx, response)
	}
}

func GetDeviceStatuses(ctx *gin.Context) {
	id := ctx.Param("id")
	if id == "" {
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, utils.ERRMSG_REQUEST_PARAM_ERROR, nil, http.StatusBadRequest)
		return
	}
	statuses, timestamp, err := modules.GetDeviceTotalStatus(id)
	if err != nil {
		utils.ResponseErrorJson(ctx, err)
	} else {
		utils.ResponseSuccessJson(ctx, gin.H{
			"statuses":  statuses,
			"timestamp": timestamp,
		})
	}
}

func GetDevicesStatuses(ctx *gin.Context) {
	statuses, timestamp, err := modules.GetDevicesTotalStatus()
	if err != nil {
		utils.Logger.Error(err)
		utils.ResponseErrorJson(ctx, err)
	} else {
		utils.ResponseSuccessJson(ctx, gin.H{
			"statuses":  statuses,
			"timestamp": timestamp,
		})
	}
}

