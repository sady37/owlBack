func InitializeDevice(ctx *gin.Context) {
	var req models.DeviceData
	if err := ctx.ShouldBindJSON(&req); err != nil {
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, err.Error(), nil, http.StatusBadRequest)
		return
	}
	utils.Logger.Infof("req: %+v", req)
	if err := modules.InitializeDevice(&req); err != nil {
		utils.ResponseErrorJson(ctx, err)
		return
	}
	utils.ResponseSuccessJson(ctx, nil)
}

func UninitializeDevice(ctx *gin.Context) {
	code := ctx.Param("code")
	if code == "" {
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, utils.ERRMSG_REQUEST_PARAM_ERROR, nil, http.StatusBadRequest)
		return
	}
	if err := modules.UninitializeDevice(code); err != nil {
		utils.ResponseErrorJson(ctx, err)
		return
	}
	utils.ResponseSuccessJson(ctx, nil)
}

func GetSleepReports(ctx *gin.Context) {
	id := ctx.Param("id")
	idInt, err := strconv.ParseInt(id, 10, 64)
	if err != nil {
		utils.Logger.Error("request param error")
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, utils.ERRMSG_REQUEST_PARAM_ERROR, nil, http.StatusBadRequest)
		return
	}
	startDate := utils.Atoi(ctx.Query("startDate"), 0)
	endDate := utils.Atoi(ctx.Query("endDate"), 0)
	if startDate == 0 || endDate == 0 {
		utils.ResponseFailedJson(ctx, utils.ERRCODE_REQUEST_PARAM_ERROR, utils.ERRMSG_REQUEST_PARAM_ERROR, nil, http.StatusBadRequest)
		return
	}
	page := utils.GeneratePaginationFromRequest(ctx, config.Cfg.Database.DefaultSize)
	deviceId := utils.LongId(idInt)
	response, err := modules.GetDailyReports(deviceId, startDate, endDate, page)
	if err == nil {
		utils.ResponseSuccessJsonWithPagination(ctx, response, page)
	} else {
		utils.ResponseErrorJson(ctx, err)
	}
}

