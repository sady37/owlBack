# OwlBack 统一配置文件模板
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=owlrd
DB_SSLMODE=disable

# ============================================
# Redis 配置
# ============================================
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=TeLunSu-36kr
REDIS_DB=0

# ============================================
# MQTT 配置（服务连接 MQTT Broker）
# ============================================
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=wisefido-service
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================
# MQTT 配置（返回给设备的配置）
# ============================================
# 设备应该连接到本机MQTT服务器
RADAR_MQTT_SERVER=10.0.0.30
RADAR_MQTT_PORT=1883
RADAR_MQTT_PROTOCOL=1
RADAR_MQTT_ACCOUNT=wfiot
RADAR_MQTT_PASSWORD=tt@wf@2025
RADAR_MQTT_PREFIX=
RADAR_MQTT_PRODUCT_ID=88
RADAR_MQTT_TIMEOUT=30
RADAR_MQTT_KEEPALIVE=60
RADAR_MQTT_CLIENT_ID_PREFIX=radar

# ============================================
# HTTP/HTTPS 配置
# ============================================
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
RADAR_HTTPS_PORT=8443
RADAR_HTTPS_CERT_FILE=
RADAR_HTTPS_KEY_FILE=

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# 租户配置
# ============================================
TENANT_ID=bb045e6b-7bc2-4e59-af2e-d8b1adc77f2c

# ============================================
# 卡片聚合配置（wisefido-card-aggregator）
# ============================================
CARD_TRIGGER_MODE=polling
CARD_POLLING_INTERVAL=86400
CARD_AGGREGATION_ENABLED=true
CARD_AGGREGATION_INTERVAL=2

# ============================================
# Redis Stream 配置（wisefido-iot-timeseries）
# ============================================
STREAM_IOT_MONITOR=iot:monitor:stream
STREAM_IOT_STAT=iot:stat:stream
STREAM_IOT_EVENT=iot:event:stream
STREAM_IOT_ALARM=iot:alarm:stream
STREAM_IOT_AUTH=iot:auth:stream

# 兼容性配置（旧名称，指向统一的 stream）
STREAM_RADAR_MONITOR=iot:monitor:stream
STREAM_RADAR_STAT=iot:stat:stream
STREAM_RADAR_EVENT=iot:event:stream
STREAM_RADAR_ALARM=iot:alarm:stream
STREAM_RADAR_AUTH=iot:auth:stream
STREAM_SLEEPACE_MONITOR=iot:monitor:stream
STREAM_SLEEPACE_STAT=iot:stat:stream
STREAM_SLEEPACE_EVENT=iot:event:stream
STREAM_SLEEPACE_ALARM=iot:alarm:stream
STREAM_SLEEPACE_AUTH=iot:auth:stream

CONSUMER_GROUP=iot-timeseries-group
CONSUMER_NAME=iot-timeseries-1

# ============================================
# 服务端口配置
# ============================================
CARD_MANAGE_PORT=8082
HTTP_ADDR=:8083
