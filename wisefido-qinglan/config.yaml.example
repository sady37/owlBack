# wisefido-qinglan 配置文件示例

server:
  port: 8080
  address: "0.0.0.0"

mqtt:
  broker: "localhost"
  port: 1883
  username: ""
  password: ""
  client_id: "wisefido-qinglan"
  
  # 雷达设备MQTT主题配置
  radar_device_mqtt:
    prefix: ""  # 主题前缀，如果为空则使用 /{type}/{productId}/{uid}/post 格式
    product_id: "radar"  # 产品ID
  
  # 订阅主题
  topics:
    property: "/prop/{productId}/{uid}/post"  # 属性响应主题
    monitor: "/monitor/{productId}/{uid}/post"  # 实时数据主题
    function: "/func/{productId}/{uid}/post"  # 功能响应主题
    stat: "/stat/{productId}/{uid}/post"  # 统计数据主题
    event: "/event/{productId}/{uid}/post"  # 事件主题
    alarm: "/alarm/{productId}/{uid}/post"  # 告警主题

http:
  port: 8081
  host: "0.0.0.0"

redis:
  address: "localhost:6379"
  password: ""
  db: 0

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "password"
  dbname: "owlrd"
  sslmode: "disable"

# 日志配置
logging:
  level: "info"  # debug, info, warn, error
  format: "json"  # json, text
  output: "stdout"  # stdout, file
  file_path: "logs/wisefido-qinglan.log"

# 缓存配置
cache:
  device_ttl: 300  # 设备缓存TTL（秒）
  location_ttl: 300  # 位置信息缓存TTL（秒）

# 流配置
streams:
  monitor:
    max_len: 50000  # 最大长度
    retention: 86400  # 保留时间（秒）
  stat:
    max_len: 10000
    retention: 2592000  # 30天
  event:
    max_len: 20000
    retention: 604800  # 7天
  alarm:
    max_len: 5000
    retention: 7776000  # 90天

# 订阅配置
subscription:
  auto_subscribe: true  # 设备首次连接时自动订阅实时数据
  default_duration: 3600  # 默认订阅时长（秒）

# 报警配置
alarm:
  enabled: true
  fall_detection: true
  breath_abnormal: true
  heart_rate_abnormal: true
  out_of_bed: true
  device_abnormal: true