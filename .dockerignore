# owlBack 根目录唯一 .dockerignore，供 docker-compose 构建 wisefido-data（context: .）使用
# 不排除：owl-common、wisefido-qinglan、wisefido-sensor、wisefido-data（构建需要）

# 运行时/权限敏感，不参与构建
mqtt/log
mqtt/data

# 版本与 IDE
.git
.idea
.vscode
.cursor
.continue
.config

# 文档与脚本（减小 context）
*.md
docs/
logging/
scripts/
examples/
exports/

# 其他大文件/无关
*.log
*.bak
.env
.env.*
!*.example
.DS_Store
